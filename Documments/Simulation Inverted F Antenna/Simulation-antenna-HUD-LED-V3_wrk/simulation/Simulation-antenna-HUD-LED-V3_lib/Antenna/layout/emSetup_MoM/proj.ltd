TECHFORMAT=V2

UNITS
  DISTANCE=METRE
  CONDUCTIVITY=SIEMENS/M
  RESISTIVITY=OHM.CM
  RESISTANCE=OHM/SQ
  PERMITTIVITY=RELATIVETOVACUUM
  PERMEABILITY=RELATIVETOVACUUM
  FREQUENCY=HZ
  TEMPERATURE=CELSIUS
END_UNITS

BEGIN_MATERIAL
  MATERIAL Copper CONDUCTIVITY=5.8e7 IMAG_CONDUCTIVITY=0 PERMEABILITY=1
  MATERIAL FR_4_Prepreg PERMITTIVITY=4.6 LOSSTANGENT=0.01 PERMEABILITY=1 DJORDJEVIC LOWFREQ=1000 VALUEFREQ=1e+09 HIGHFREQ=1e+12
END_MATERIAL

BEGIN_OPERATION
  OPERATION OperationSHEET SHEET
  OPERATION OperationThickness_cond INTRUDE=0.00137 UP
  OPERATION OperationThickness_cond2 INTRUDE=3.4798e-05 UP
  OPERATION OperationThickness_Layer_1 INTRUDE=3.4798e-05 UP
  OPERATION OperationThickness_Layer_2 INTRUDE=3.4798e-05 UP
  OPERATION OperationDRILL DRILL
  OPERATION OperationTSV_hole DRILL
END_OPERATION

BEGIN_MASK
  MASK 1 Name=cond PRECEDENCE=1 COLOR="ee6a50" MATERIAL=Copper OPERATION=OperationThickness_cond MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 2 Name=cond2 PRECEDENCE=0 COLOR="ffff00" MATERIAL=Copper OPERATION=OperationThickness_cond2 MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 5 Name=hole PRECEDENCE=0 COLOR="00bfff" MATERIAL=FR_4_Prepreg OPERATION=OperationDRILL
  MASK 43 Name=Layer_1 PRECEDENCE=0 COLOR="0000ff" MATERIAL=Copper OPERATION=OperationThickness_Layer_1 MASK_PROPERTIES = { "TopTechnologyMaskName=Layer 1", "OriginalName=Layer 1", "MomModelType=operation2sheet" }
  MASK 44 Name=Layer_2 PRECEDENCE=0 COLOR="ff00ff" MATERIAL=Copper OPERATION=OperationThickness_Layer_2 MASK_PROPERTIES = { "TopTechnologyMaskName=Layer 2", "OriginalName=Layer 2", "MomModelType=operation2sheet" }
END_MASK

BEGIN_STACK
  TOP OPEN MATERIAL=AIR
  INTERFACE Name=__Interface3      MASK={cond}
  LAYER     Name=__SubstrateLayer3 MASK={hole} HEIGHT=0.00015 MATERIAL=FR_4_Prepreg
  INTERFACE Name=__Interface2      MASK={Layer_1}
  LAYER     Name=__SubstrateLayer2 MASK={hole} HEIGHT=0.00065 MATERIAL=FR_4_Prepreg
  INTERFACE Name=__Interface1      MASK={Layer_2}
  LAYER     Name=__SubstrateLayer1 MASK={hole} HEIGHT=0.00015 MATERIAL=FR_4_Prepreg
  INTERFACE Name=__Interface0      MASK={cond2}
  BOTTOM OPEN MATERIAL=AIR
END_STACK

